youtube_youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{"lyricLang":"{{{youtube_歌词翻译语言}}}","captionLang":"{{{youtube_字幕翻译语言}}}","blockUpload":{{{youtube_屏蔽上传按钮}}},"blockImmersive":{{{youtube_屏蔽选段按钮}}},"blockShorts":{{{youtube_屏蔽Shorts按钮}}},"debug":{{{youtube_启用调试模式}}}}"
