#!name=彩云天气净化
#!desc=引用原作者 caiyun.js 的广告与发现页净化规则
#!system=ios

[Rule]
DOMAIN,gather.colorfulclouds.net,REJECT

[URL Rewrite]
^https://ad.cyapi.cn/v2/req?app_name=weather - reject
^https://biz.cyapi.cn/p/v1/trial_card/info - reject
^https://biz.cyapi.cn/p/v1/entries - reject
^https://starplucker.cyapi.cn/v3/config$ - reject
^https://starplucker.cyapi.cn/v3/notification/message_center - reject
^https://starplucker.cyapi.cn/v3/config/cypage/home/conditions/local$ - reject
^https://starplucker.cyapi.cn/v3/config/cypage/home_activity/conditions$ - reject
^https://starplucker.cyapi.cn/v3/config/cypage/40day/conditions/local$ - reject

[Script]
彩云天气-活动 = type=http-response,pattern=^https://wrapper.cyapi.cn/v1/activity?app_name=weather,requires-body=true,script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js

彩云天气-发现轮播 = type=http-response,pattern=^https://starplucker.cyapi.cn/v3/operation/banners?user_type=,requires-body=true,script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js

彩云天气-发现宫格 = type=http-response,pattern=^https://starplucker.cyapi.cn/v3/operation/features?user_type=,requires-body=true,script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js

彩云天气-发现活动 = type=http-response,pattern=^https://starplucker.cyapi.cn/v3/campaigns$,requires-body=true,script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js

彩云天气-发现信息流 = type=http-response,pattern=^https://starplucker.cyapi.cn/v3/operation/feeds,requires-body=true,script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js

[MITM]
hostname = %APPEND% ad.cyapi.cn, biz.cyapi.cn, starplucker.cyapi.cn, wrapper.cyapi.cn