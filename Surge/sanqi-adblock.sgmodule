#!name=三七去广告
#!desc=三七常用去广告规则合集：通用广告域名 + 拼多多 + 微信小程序/微博/菜鸟/淘宝/高德/滴滴/彩云/优酷等 + 京东/哔哩哔哩/贴吧/抖音/闲鱼/夸克/下厨房；不含 perzikkop 脚本；优先推荐直接装奶思 blockAds.module
#!author=阿紫
#!icon=https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/icon.png

[Rule]
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Advertising/Advertising.list,REJECT
