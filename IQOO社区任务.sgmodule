#!name=IQOO社区每日任务
#!desc=IQOO社区签到、浏览任务，可设置每日运行时间、Token捕获、发帖、抽奖和浏览数量
#!arguments=schedule:"0 9 * * *",token_host:bbs-api.iqoo.com,thread:false,draw:false,browse_count:15
#!arguments-desc=schedule：Cron表达式（默认每天09:00）；token_host：Token捕获域名，设为token-disabled.invalid可尝试关闭捕获；thread：是否发帖；draw：是否抽奖；browse_count：浏览文章数量（1-26）

[Script]
IQOO获取Token = type=http-response, pattern=^https://{{{token_host}}}/api/v3/user\?userId=, requires-body=true, timeout=30, script-path=https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/iqoo-surge.js

IQOO每日任务 = type=cron, cronexp="{{{schedule}}}", timeout=360, script-path=https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/iqoo-surge.js, argument="thread={{{thread}}}&draw={{{draw}}}&browse_count={{{browse_count}}}"

[MITM]
hostname = %APPEND% bbs-api.iqoo.com
