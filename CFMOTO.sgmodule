#!name=🏍️ 春风摩托【每日任务】
#!desc=春风摩托每日任务，可自定义执行时间及Cookie捕获
#!arguments=定时任务:0 7 * * *,禁用获取Cookie:否,禁用MITM:否
#!arguments-desc=定时任务：Cron表达式，默认每天早上07:00执行。\n禁用获取Cookie：选择“是”关闭Cookie捕获，选择“否”开启。\n禁用MITM：选择“是”时请同时在主配置中移除 c.cfmoto.com；选择“否”则保留。

[Script]
# Cookie捕获
春风摩托Cookie = type=http-response, pattern=^https:\/\/c\.cfmoto\.com\/jv\/user\/user_info, requires-body=true, timeout=60, script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/cfmoto/cfmoto.js

# 每日任务
春风摩托任务 = type=cron, cronexp="{{{定时任务}}}", timeout=360, script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/cfmoto/cfmoto.js

[URL Rewrite]
# 开屏广告
^https:\/\/c\.cfmoto\.com\/cfmotoservermall\/app\/ad$ reject-dict

# 弹窗广告
^https:\/\/c\.cfmoto\.com\/cfmotoservermall\/app\/popwindow reject-dict

[MITM]
hostname = %APPEND% c.cfmoto.com