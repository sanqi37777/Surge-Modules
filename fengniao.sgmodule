#!name=蜂鸟众包 xtop 重放探针（测试用）
#!desc=捕获 App 原生 pizza 请求的登录态头（只存手机本地），手动运行探针重放签到接口，验证 xtop 是否无签名可重放。验证完请停用本模块。
#!category=测试

[Script]
# 捕获：App 每次发原生 pizza 请求时，把登录态头存到本地（不改请求本身）
pizza登录态捕获 = type=http-request, pattern=^https://httpizza\.ele\.me/lpd_knight\., script-path=https://cdn.jsdelivr.net/gh/sanqi37777/Surge-Modules@main/eleme_pizza_probe.js, requires-body=false

# 探针：定时表达式设在 2 月 29 日，正常不会自动触发；在 Surge「脚本」面板手动运行一次即可
pizza重放探针 = type=cron, cronexp="0 0 29 2 *", script-path=https://cdn.jsdelivr.net/gh/sanqi37777/Surge-Modules@main/eleme_pizza_probe.js, timeout=60

[MITM]
hostname = %APPEND% httpizza.ele.me
