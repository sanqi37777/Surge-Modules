#!name=PingMe每日签到+视频奖励
#!desc=PingMe账号参数抓取、每日签到与视频奖励；可自定义运行时间
#!arguments=schedule:30 8-20/12 * * *,capture_script:PingMe参数抓取,mitm_key:hostname
#!arguments-desc=定时任务：Cron表达式，默认每天08:30和20:30运行。\ncapture_script：账号参数抓取脚本名称，输入 # 表示禁用。\nmitm_key：MITM主机名配置项，输入 # 表示禁用。

[Script]
{{{capture_script}}} = type=http-request, pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus, requires-body=false, timeout=30, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/PingMe.js

PingMe每日任务 = type=cron, cronexp="{{{schedule}}}", timeout=360, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/PingMe.js

[MITM]
{{{mitm_key}}} = %APPEND% api.pingmeapp.net