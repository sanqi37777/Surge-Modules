#!name=Rokid每日任务
#!desc=Rokid每日签到及积分任务
#!arguments=schedule:34 8,17 * * *,accounts:
#!arguments-desc=账号密码格式：账号1&密码1 账号2&密码2，多个账号用空格分隔

[Script]
Rokid每日任务 = type=cron, cronexp="{{{schedule}}}", timeout=360, script-path=Rokid.js, argument="Rokid={{{accounts}}}"

[MITM]
hostname = %APPEND% account-center.rokid.com, forum-ugc-api.rokid.com