#!name=🏍️ 春风摩托
#!desc=春风摩托每日任务（由 Surge 模块转换的 Loon 版），含 Cookie 捕获、每日任务与开屏/弹窗广告拦截
#!author=sanqi37777
#!homepage=https://github.com/sanqi37777/Surge-Modules
#!tag=签到,任务
#!date=2026-10-20

[Argument]
cron_expr = input, "0 7 * * *", type=string, tag=定时任务, desc=Cron 表达式，默认每天 07:00 执行

[Script]
# Cookie 捕获
http-response ^https:\/\/c\.cfmoto\.com\/jv\/user\/user_info script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/cfmoto/cfmoto.js, requires-body=true, timeout=60, tag=春风摩托Cookie捕获

# 每日任务
cron "{cron_expr}" script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/cfmoto/cfmoto.js, timeout=360, tag=春风摩托每日任务

[Rewrite]
# 开屏广告
^https:\/\/c\.cfmoto\.com\/cfmotoservermall\/app\/ad$ reject-dict

# 弹窗广告
^https:\/\/c\.cfmoto\.com\/cfmotoservermall\/app\/popwindow reject-dict

[MITM]
hostname = c.cfmoto.com
