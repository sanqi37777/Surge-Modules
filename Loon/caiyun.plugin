#!name = 彩云天气
#!desc = 由 Surge 模块 caiyun.sgmodule 转换：彩云天气去广告 + 解锁 SVIP，脚本仍指向原作者 wf021325 的地址，上游更新自动生效。注意：大于 7.20.2 的版本不可以 MITM 解锁，需使用最新版（如 7.22.0），可通过登录旧版解锁后在线升级到新版；广告无法消除时可卸载重装，或清除 App 数据后重新登录。需要 Loon 3.5.1(983) 及以上。
#!author = wf021325（原作）
#!homepage = https://github.com/sanqi37777/Surge-Modules
#!system = iOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-06
#!tag = 去广告
#!type = normal

[Rule]
DOMAIN,gather.colorfulclouds.net,REJECT

[Rewrite]
^https:\/\/ad\.cyapi\.cn\/v2\/req\?app_name=weather reject-dict
^https:\/\/biz\.cyapi\.cn\/p\/v1\/trial_card\/info reject-dict
^https:\/\/biz\.cyapi\.cn\/api\/v1\/token\/device$ reject-dict
^https:\/\/biz\.cyapi\.cn\/p\/v1\/entries reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/config$ reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/notification\/message_center reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/config\/cypage\/home\/conditions\/local$ reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/config\/cypage\/home_activity\/conditions$ reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/config\/cypage\/40day\/conditions\/local$ reject-dict

[Script]
response if ${url} ~= /^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\?app_name=weather/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-活动", timeout=60
response if ${url} ~= /^https:\/\/biz\.cyapi\.cn\/v2\/user/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-旧版VIP", timeout=60
request if ${url} ~= /^https:\/\/wrapper\.cyapi\.cn\/v1\/(satellite|nafp\/origin_images)/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with tag="彩云天气-卫星云图", timeout=60
response if ${url} ~= /^https?:\/\/biz\.cyapi\.cn\/api\/v1\/user_detail$/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-VIP详情", timeout=60
request if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\//i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-星图请求", timeout=60
response if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/operation\/banners\?user_type=/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-轮播", timeout=60
response if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/operation\/features\?user_type=/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-宫格", timeout=60
response if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/campaigns$/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-官方活动", timeout=60
response if ${url} ~= /^https:\/\/starplucker\.cyapi\.cn\/v3\/operation\/feeds/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/caiyun.js") with requires_body=true, tag="彩云天气-瀑布流", timeout=60

[Mitm]
hostname = *.cyapi.cn
