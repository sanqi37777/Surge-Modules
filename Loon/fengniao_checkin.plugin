#!name = 蜂鸟众包自动签到（正式版）
#!desc = 由 Surge 模块 fengniao_checkin.sgmodule 转换：每天 06:10 用 App 原生 pizza 请求的登录态头（只存手机本地）重放 clock 签到，5004「今日已签到」视为成功，再调详情接口核对今日状态；登录态首次保存或有变化时会通知一次。无签名可重放已于 2026-10-21 由探针实测通过。06:40 另有一次补签检查：先查今日状态，未签才补 clock，已签则静默跳过。需要 Loon 3.5.1(983) 及以上。
#!author = sanqi37777
#!homepage = https://github.com/sanqi37777/Surge-Modules
#!system = iOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-06
#!tag = 签到,自动化
#!type = normal

[Argument]
checkin_time = input,"10 6 * * *",type=string,tag=签到时间,desc=Cron 表达式，默认 10 6 * * * 即每天 06:10。
backup_time = input,"40 6 * * *",type=string,tag=补签时间,desc=Cron 表达式，默认 40 6 * * * 即每天 06:40。
capture_mode = select,"notify","silent","off",type=string,tag=捕获模式,desc=notify（默认，保存且变化时通知）、silent（只保存不通知）、off（不捕获，登录态过期后需重新开启并进 App 刷新）。

[Script]
request if ${url} ~= /^https:\/\/httpizza\.ele\.me\/lpd_knight\./i then script("https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/eleme_checkin_v2.js", "capture_mode=${capture_mode}") with tag="pizza登录态捕获"
cron ${checkin_time} then script("https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/eleme_checkin_v2.js") with tag="蜂鸟每日签到", timeout=60
cron ${backup_time} then script("https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/eleme_checkin_v2.js", "backup") with tag="蜂鸟签到补签检查", timeout=60

[Mitm]
hostname = httpizza.ele.me
