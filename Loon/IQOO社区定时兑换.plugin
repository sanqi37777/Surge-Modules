#!name=🐻 IQOO社区
#!icon = https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Loon/icons/iqoo.jpg
#!desc=IQOO社区酷币商城定时兑换：每天 11:00 一班，两个号一次跑完，不用补跑；商品ID=0 只列商品不兑换；每个号打开一次 IQOO 社区就自动存好登录态，和签到插件共用一套；抓完两个号可以把获取Token开关关掉
#!author=sanqi37777
#!homepage=https://github.com/sanqi37777/Surge-Modules
#!system = iOS
#!loon_version = 3.5.1(983)
#!tag=兑换,任务
#!date=2026-11-10

[Argument]
cron_expr = input, "0 11 * * *", type=string, tag=定时兑换, desc=Cron 表达式，默认每天 11:00 执行
capture = switch,true,type=boolean,tag=获取Token开关,desc=true 开启，打开 IQOO 社区时自动抓登录态；抓完两个号可以关掉，换号或登录态过期时再开。
giftId = input, "2101010", type=number, tag=商品ID, desc=要抢的商品 id，默认 2101010（11 月 9 日 11:00 那批的 33W 充电宝，已兑完）；填 0 只列商品不兑换，先看列表再填
acc = input, -1, type=number, tag=兑换账号, desc=-1=两个号都跑（默认，明天 11 点两副都抢）；0=只跑第一个号；1=只跑第二个号，跟原作者 IQOO_Acc 一个意思
addressId = input, "0", type=number, tag=收货地址ID, desc=默认 0：自动取每个号自己的默认收货地址；想指定再填地址 id
retry = input, 5, type=number, tag=重试次数, desc=兑换失败重试几次，默认 5，范围 1-10
interval = input, 1200, type=number, tag=重试间隔毫秒, desc=两次兑换之间隔多久，默认 1200，范围 300-10000

[Script]
# 捕获登录态（打开 IQOO 社区 App 时自动保存 Token，按账号存，两个号各打开一次就都存好了）
# Loon 3.5.1+ 新写法：参数以对象形式传，$argument 是带类型的对象；旧的字符串拼接写法在新版下开关/数字传不过去
response if ${url} ~= /^https:\/\/bbs-api\.iqoo\.com\/api\/v3\/user\?userId=/i then script("https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/IQOO_Exchange.js", {${capture}}) with requires_body=true, tag="IQOO兑换Token捕获", timeout=30

# 定时兑换（每天 11:00 一班，两个号一次跑完）
cron ${cron_expr} then script("https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/IQOO_Exchange.js", {${giftId}, ${acc}, ${addressId}, ${retry}, ${interval}}) with tag="IQOO定时兑换", timeout=120

[Mitm]
hostname = bbs-api.iqoo.com
