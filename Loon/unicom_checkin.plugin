#!name = 中国联通首页签到
#!icon = https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Loon/icons/unicom.jpg
#!desc = 由 Surge 模块 unicom_checkin.sgmodule 转换：仅首页签到区（getContinuous 查状态 + daySign 打卡），领话费红包/积分。认证只用 Cookie（token_online + appId + 本地 UUID）加一个 UA，不用 RSA；token_online 由捕获脚本从联通 App 的 onLine.htm 请求自动存（只存手机本地），appId 抓不到时按原版格式本地生成。需要 Loon 3.5.1(983) 及以上。原脚本由 smallfawn/QLScriptPublic 的联通脚本抽出。
#!author = sanqi37777
#!homepage = https://github.com/sanqi37777/Surge-Modules
#!system = iOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-06
#!tag = 签到,自动化
#!type = normal

[Argument]
unicom_sign_time = input,"5 6 * * *",type=string,tag=签到时间,desc=Cron 表达式，默认 5 6 * * * 即每天 06:05。
capture_mode = select,"notify","silent","off",type=string,tag=捕获模式,desc=notify（默认，保存且变化时通知）、silent（只保存不通知）、off（不捕获）。
unicom_cookie = input,"请粘贴联通App的完整Cookie",type=string,tag=完整 Cookie,desc=粘贴联通 App 的完整 Cookie（即小组件用的那条），脚本直接拿它当请求头去签到，优先于 token_online；留空或保持占位文字则回落到 token_online 捕获路径。Cookie 只存你自己手机本地，别发聊天。

[Script]
request if ${url} ~= /^https:\/\/m\.client\.10010\.com\/mobileService\/onLine\.htm/i then script("https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/unicom_checkin.js", "capture_mode=${capture_mode}") with requires_body=true, tag="联通登录态捕获"
cron ${unicom_sign_time} then script("https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/unicom_checkin.js", "unicom_cookie=${unicom_cookie}") with tag="联通首页签到", timeout=60

[Mitm]
hostname = m.client.10010.com
