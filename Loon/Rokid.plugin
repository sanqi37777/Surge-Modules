#!name=Rokid每日任务
#!desc=Rokid每日签到、积分任务及积分查询（由 Surge 模块转换的 Loon 版）
#!author=sanqi37777
#!homepage=https://github.com/sanqi37777/Surge-Modules
#!tag=签到,任务
#!date=2026-10-20

[Argument]
accounts = input, "", type=string, tag=账号密码, desc=格式为账号&密码；多个账号之间用空格分隔

[Script]
cron "34 8,17 * * *" script-path=https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/Rokid.js, timeout=360, tag=Rokid每日任务, argument="Rokid={accounts}"

[MITM]
hostname = account-center.rokid.com, forum-ugc-api.rokid.com
