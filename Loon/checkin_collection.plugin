#!name=签到合集（蜂鸟·春风·IQOO·Rokid）
#!desc=四个签到插件的合集版：一次安装、一个入口。所有脚本仍走各自原链接（春风为原作者 leiyiyan 的地址，其余为本仓库 Scripts/），脚本更新自动跟随；本合集只合并安装配置。启用合集后请移除单独的四个插件，避免任务重复运行。Rokid 账号密码在插件参数里填（只存手机本地）。
#!author=sanqi37777
#!homepage=https://github.com/sanqi37777/Surge-Modules
#!tag=签到,任务
#!date=2026-10-21

[Argument]
cfmoto_cron = input, "0 7 * * *", type=string, tag=春风定时任务, desc=Cron 表达式，默认每天 07:00 执行
iqoo_cron = input, "0 9 * * *", type=string, tag=IQOO定时签到, desc=Cron 表达式，默认每天 09:00 执行
thread = select, "false", "true", type=string, tag=IQOO发帖任务, desc=选 true 开启发帖任务
draw = select, "false", "true", type=string, tag=IQOO抽奖任务, desc=选 true 开启抽奖任务
browse_count = input, 15, type=number, tag=IQOO浏览文章数量, desc=范围 1-26
accounts = input, "", type=string, tag=Rokid账号密码, desc=格式为账号&密码；多个账号之间用空格分隔

[Script]
# ===== 春风摩托（原作者 leiyiyan 脚本） =====
http-response ^https:\/\/c\.cfmoto\.com\/jv\/user\/user_info script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/cfmoto/cfmoto.js, requires-body=true, timeout=60, tag=春风摩托Cookie捕获
cron "{cfmoto_cron}" script-path=https://raw.githubusercontent.com/leiyiyan/resource/main/script/cfmoto/cfmoto.js, timeout=360, tag=春风摩托每日任务

# ===== IQOO 社区 =====
http-response ^https:\/\/bbs-api\.iqoo\.com\/api\/v3\/user\?userId= script-path=https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/iqoo-surge.js, requires-body=true, timeout=30, tag=IQOO获取Token
cron "{iqoo_cron}" script-path=https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/iqoo-surge.js, timeout=360, tag=IQOO每日任务, argument="thread={thread}&draw={draw}&browse_count={browse_count}"

# ===== Rokid =====
cron "34 8,17 * * *" script-path=https://raw.githubusercontent.com/sanqi37777/Surge-Modules/main/Scripts/Rokid.js, timeout=360, tag=Rokid每日任务, argument="Rokid={accounts}"

# ===== 蜂鸟众包（正式版，2026-10-21 探针实测无签名可重放） =====
http-request ^https://httpizza\.ele\.me/lpd_knight\. script-path=https://cdn.jsdelivr.net/gh/sanqi37777/Surge-Modules@main/Scripts/eleme_checkin_v2.js, requires-body=false, tag=pizza登录态捕获
cron "0 9 * * *" script-path=https://cdn.jsdelivr.net/gh/sanqi37777/Surge-Modules@main/Scripts/eleme_checkin_v2.js, timeout=60, tag=蜂鸟每日签到

[Rewrite]
# 春风开屏广告
^https:\/\/c\.cfmoto\.com\/cfmotoservermall\/app\/ad$ reject-dict
# 春风弹窗广告
^https:\/\/c\.cfmoto\.com\/cfmotoservermall\/app\/popwindow reject-dict

[MITM]
hostname = c.cfmoto.com, bbs-api.iqoo.com, account-center.rokid.com, forum-ugc-api.rokid.com, httpizza.ele.me
